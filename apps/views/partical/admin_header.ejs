<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản trị - Flower Shop</title>
    <!-- Modern & Elegant Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header">
            <img src="/admin/images/logo.png" alt="Logo">
            <span>FLOWER ADMIN</span>
        </div>
        
        <ul class="nav-menu">
            <li class="nav-item">
                <a href="/admin" class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>">
                    <i class="fa-solid fa-leaf"></i>
                    Bảng điều khiển
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/add" class="nav-link <%= currentPage === 'add_product' ? 'active' : '' %>">
                    <i class="fa-solid fa-seedling"></i>
                    Thêm sản phẩm
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <div class="admin-info">
                <div class="avatar-circle"><%= user.username.charAt(0).toUpperCase() %></div>
                <div style="flex: 1; overflow: hidden;">
                    <div style="font-weight:700; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= user.username %></div>
                    <div style="font-size: 0.75rem; color: rgba(255,255,255,0.5); font-weight: 500;">Quản lý kho hoa</div>
                </div>
            </div>
            <a href="/admin/logout" class="nav-link" style="color: #f28482; background: transparent; padding: 10px 20px;">
                <i class="fa-solid fa-power-off"></i>
                Rời hệ thống
            </a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-header">
            <div class="welcome-text">
                <h1>Khu Vườn Của Bạn 🌿</h1>
                <p>Quản lý các mẫu hoa tươi trong kho hàng</p>
            </div>
            <div style="font-weight: 700; color: var(--secondary); font-size: 0.9rem; background: white; padding: 12px 20px; border-radius: 50px; box-shadow: var(--shadow-soft);">
                <i class="fa-regular fa-calendar-check" style="margin-right: 8px; color: var(--primary);"></i>
                <%= new Date().toLocaleDateString('vi-VN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
            </div>
        </header>
