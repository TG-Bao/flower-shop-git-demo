<%- include('../partical/admin_header', { currentPage: 'dashboard' }) %>

<div class="glass-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h2 style="margin:0; font-weight: 800; font-size: 1.5rem;">Danh sách sản phẩm</h2>
        <a href="/admin/add" class="btn-modern">
            <i class="fa-solid fa-plus"></i> Thêm mới
        </a>
    </div>

    <div class="table-responsive">
        <table class="modern-table">
            <thead>
                <tr>
                    <th width="45%">Sản phẩm</th>
                    <th width="15%">Giá bán</th>
                    <th width="20%">Trạng thái</th>
                    <th width="20%" style="text-align: right;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach(p => { %>
                <tr class="product-row">
                    <td>
                        <div style="display: flex; align-items: center; gap: 15px;">
                            <div class="img-container">
                                <img src="/<%= p.image %>" alt="<%= p.name %>">
                            </div>
                            <div>
                                <div style="font-weight: 700; font-size: 1.05rem;"><%= p.name %></div>
                                <div style="font-size: 0.85rem; color: var(--text-muted); max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <%= p.description %>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="price-tag">$<%= p.price %></span>
                    </td>
                    <td>
                        <span class="status-badge status-online">✔️ Đang bán</span>
                    </td>
                    <td>
                        <div class="action-btns" style="justify-content: flex-end;">
                            <a href="/admin/edit/<%= p.id %>" class="icon-btn btn-edit" title="Chỉnh sửa">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <a href="/admin/delete/<%= p.id %>" class="icon-btn btn-delete" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')" title="Xóa">
                                <i class="fa-solid fa-trash-can"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

</main>
<script src="/admin/js/admin.js"></script>
</body>
</html>
