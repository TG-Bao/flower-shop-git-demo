<%- include('../partical/admin_header', { currentPage: 'add_product' }) %>

<div class="glass-card" style="max-width: 800px; margin: 0 auto;">
    <div style="margin-bottom: 40px; text-align: center;">
        <h2 style="font-weight: 800; font-size: 1.8rem; margin-bottom: 10px;">Thêm Sản Phẩm Mới</h2>
        <p style="color: var(--text-muted);">Điền thông tin chi tiết để đưa sản phẩm lên kệ hàng</p>
    </div>

    <form action="/admin/add" method="POST">
        <div class="classic-form-group">
            <label>Tên sản phẩm</label>
            <input type="text" name="name" class="modern-input" placeholder="Ví dụ: Hoa Hồng Đỏ Pháp" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">
            <div class="classic-form-group">
                <label>Giá bán ($)</label>
                <input type="number" name="price" class="modern-input" placeholder="Giá niêm yết" required>
            </div>
            <div class="classic-form-group">
                <label>Hình minh họa</label>
                <select name="image" class="modern-input">
                    <option value="images/prod1.gif">Mặc định (Hoa hồng)</option>
                    <option value="images/prod1.gif">Hoa Hồng (Lớn)</option>
                    <option value="images/prod2.gif">Hoa Ly (Lớn)</option>
                </select>
            </div>
        </div>

        <div class="classic-form-group">
            <label>Mô tả sản phẩm</label>
            <textarea name="description" class="modern-input" rows="4" placeholder="Viết vài dòng giới thiệu về sản phẩm này..."></textarea>
        </div>

        <div style="display: flex; gap: 20px; margin-top: 40px;">
            <button type="submit" class="btn-modern" style="flex: 2; justify-content: center;">
                <i class="fa-solid fa-check"></i> Lưu Sản Phẩm
            </button>
            <a href="/admin" class="btn-modern" style="flex: 1; justify-content: center; background: #e2e8f0; color: #64748b;">
                Hủy bỏ
            </a>
        </div>
    </form>
</div>

</main>
<script src="/admin/js/admin.js"></script>
</body>
</html>
