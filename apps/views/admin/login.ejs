<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập Quản trị - Flower Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/admin/css/login.css">
</head>
<body>
    <div class="login-card">
        <img src="/admin/images/logo.png" alt="Flower Admin Logo">
        <div class="card-header">
            <h1>Flower Admin</h1>
            <p>Hệ thống quản lý cửa hàng hoa</p>
        </div>

        <% if (locals.error) { %>
            <div class="error-box"><%= error %></div>
        <% } %>

        <form action="/admin/login" method="POST">
            <div class="form-group">
                <label>Tên đăng nhập</label>
                <input type="text" name="username" placeholder="Nhập tài khoản" required autofocus>
            </div>
            
            <div class="form-group">
                <label>Mật mã</label>
                <input type="password" name="password" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn-login">Đăng Nhập Quản Trị</button>
        </form>

        <a href="/" class="back-to-shop">
            ← Quay lại trang chủ cửa hàng
        </a>
    </div>
</body>
</html>
