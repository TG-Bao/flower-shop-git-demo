<%- include('../partical/admin_header', { currentPage: 'dashboard' }) %>

<div class="glass-card" style="max-width: 800px; margin: 0 auto;">
    <div style="margin-bottom: 40px; text-align: center;">
        <h2 style="font-weight: 800; font-size: 1.8rem; margin-bottom: 10px;">Chỉnh Sửa Sản Phẩm</h2>
        <p style="color: var(--text-muted);">Cập nhật thông tin cho sản phẩm "<%= product.name %>"</p>
    </div>

    <form action="/admin/edit/<%= product.id %>" method="POST">
        <div class="classic-form-group">
            <label>Tên sản phẩm</label>
            <input type="text" name="name" class="modern-input" value="<%= product.name %>" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">
            <div class="classic-form-group">
                <label>Giá bán ($)</label>
                <input type="number" name="price" class="modern-input" value="<%= product.price %>" required>
            </div>
            <div class="classic-form-group">
                <label>Hình minh họa</label>
                <select name="image" class="modern-input">
                    <option value="images/prod1.gif" <%= product.image === 'images/prod1.gif' ? 'selected' : '' %>>Hoa Hồng</option>
                    <option value="images/prod2.gif" <%= product.image === 'images/prod2.gif' ? 'selected' : '' %>>Hoa Ly</option>
                </select>
            </div>
        </div>

        <div class="classic-form-group">
            <label>Mô tả sản phẩm</label>
            <textarea name="description" class="modern-input" rows="4"><%= product.description %></textarea>
        </div>

        <div style="display: flex; gap: 20px; margin-top: 40px;">
            <button type="submit" class="btn-modern" style="flex: 2; justify-content: center;">
                <i class="fa-solid fa-floppy-disk"></i> Cập Nhật Thay Đổi
            </button>
            <a href="/admin" class="btn-modern" style="flex: 1; justify-content: center; background: #e2e8f0; color: #64748b;">
                Quay lại
            </a>
        </div>
    </form>
</div>

</main>
<script src="/admin/js/admin.js"></script>
</body>
</html>
