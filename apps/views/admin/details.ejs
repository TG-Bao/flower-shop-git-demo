<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<title>Flower Shop - <%= product.name %></title>
<%- include('../partical/head') %>
</head>
<body>
<div id="templatemo_container">
    <div id="templatemo_header">
        <img src="/images/templatemo_site_header.jpg" alt="Flower Shop" />
    </div>
    
    <%- include('../partical/menu', { currentPage: 'details' }) %>
    
    <div id="templatemo_content">
        <div id="templatemo_content_left">
            <h1><%= product.name %></h1>
            <div class="product_box">
                <img src="/<%= product.image %>" alt="<%= product.name %>" width="200" />
            </div>
            <div class="product_details">
                <p><strong>Description:</strong> <%= product.description %></p>
                <div class="price">PRICE:<span>$<%= product.price %>.00</span></div>
                <div class="buynow"><a href="#">Order Now</a></div>
            </div>
        </div>
        <div id="templatemo_content_right">
            <div class="templatemo_right_section">
                <h4>Back to Shop</h4>
                <div class="templatemo_right_section_content">
                    <a href="/">&lt;&lt; Go Back</a>
                </div>
            </div>
        </div>
        <div class="cleaner">&nbsp;</div>
    </div>
    <%- include('../partical/footer') %>
</div>
</body>
</html>
